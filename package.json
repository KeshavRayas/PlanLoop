{
  "name": "planloop",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "bun run --filter @planloop/bootstrap setup",
    "doctor": "bun run --filter @planloop/bootstrap doctor",
    "lint": "eslint packages/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test packages/"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
